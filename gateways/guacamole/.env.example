# Copy to .env next to docker-compose.yml. That file is git-ignored.
# Every value here is an example and names nothing real.

# Public URL the directory redirects back to. Must match the redirect URI
# registered on the application exactly, including the trailing path.
PUBLIC_URL=https://gateway.example.com/guacamole/

# Database. The password is read by both postgres and the web app.
POSTGRES_DB=guacamole
POSTGRES_USER=guacamole
POSTGRES_PASSWORD=change-me-before-first-start

# OIDC. These four come from the directory's discovery document at
# /.well-known/openid-configuration. Guacamole uses the implicit flow, so there
# is no client secret here and the application registration must allow it.
OIDC_ISSUER=https://login.example.com/00000000-0000-0000-0000-000000000000/v2.0
OIDC_AUTHORIZATION_ENDPOINT=https://login.example.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/authorize
OIDC_JWKS_ENDPOINT=https://login.example.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Claim the username is taken from. This string ends up in the recording
# filename, so it has to match what sssd reports on the hosts.
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups
OIDC_SCOPE=openid profile email

# Reverse proxy addresses allowed to set X-Forwarded-For. A too-wide regex here
# lets a client spoof its own source address in the audit trail.
PROXY_ALLOWED_IPS_REGEX=127\.0\.0\.1|::1

# Recording retention. PRUNE_DRY_RUN=1 logs and deletes nothing.
RECORDING_RETENTION_DAYS=90
PRUNE_INTERVAL_SECONDS=86400
PRUNE_DRY_RUN=1

# guacd log level: trace, debug, info, warning, error.
GUACD_LOG_LEVEL=info
