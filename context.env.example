# Copy to context.env and fill in the real values, then run "make context".
# context.env and the rendered README.local.md are both git-ignored.
# The values below are examples and name nothing real.
#
# These are the only details removed from this repository. Everything below the
# Context section in README.md is unredacted.

# Organisation the work was done for.
CLIENT=example-client

# Named environment the work ran in, as that organisation named it. Not dev-or-prod
# in the sense the rest of this portfolio uses the word.
ENVIRONMENT=example-environment

# Internal name of the workstream this repository came out of.
ENGAGEMENT=example-engagement
